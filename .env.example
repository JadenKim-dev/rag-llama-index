LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_REQUEST_TIMEOUT=300
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONTEXT_WINDOW=4096
