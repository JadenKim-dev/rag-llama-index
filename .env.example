LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_REQUEST_TIMEOUT=300
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONTEXT_WINDOW=4096
# Use `ollama` when backend runs in Docker Compose with the Ollama service.
OLLAMA_BASE_URL=http://ollama:11434
# Use `localhost` when backend and Ollama run directly on the host machine.
# OLLAMA_BASE_URL=http://localhost:11434
# If backend runs in Docker and Ollama runs on the host, use `host.docker.internal`.
# OLLAMA_BASE_URL=http://host.docker.internal:11434

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

EMBED_DEVICE=mps

VECTOR_STORE_PATH=./storage
CHROMA_COLLECTION=code_index

# Use `qdrant` when backend runs in Docker Compose with the Qdrant service.
QDRANT_HOST=qdrant
# Use `localhost` when backend and Qdrant run directly on the host machine.
# QDRANT_HOST=localhost
# If backend runs in Docker and Qdrant runs on the host, use `host.docker.internal`.
# QDRANT_HOST=host.docker.internal
QDRANT_PORT=6333
