# OLLAMA_BASE_URL=http://host.docker.internal:11434

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

EMBED_DEVICE=mps

VECTOR_STORE_PATH=./storage
CHROMA_COLLECTION=code_index

QDRANT_HOST=qdrant
